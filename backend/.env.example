APP_NAME=Evolvus360
APP_ENV=development
DEBUG=False
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

EMAIL_SERVICE_BASE_URL=http://127.0.0.1:8001
EMAIL_SERVICE_API_KEY=
EMAIL_SERVICE_TIMEOUT_SECONDS=10
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/reset-password
FRONTEND_ONBOARDING_URL=http://localhost:4200/onboarding
ONBOARDING_INVITATION_EXPIRE_HOURS=48
MAX_ONBOARDING_FILE_SIZE_BYTES=5242880
PRIVATE_UPLOAD_DIR=private_uploads
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=
# Development convenience only; never configure this in production.
DEV_PASSWORD_RESET_TOKEN=

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/Evolvus360
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
DB_CONNECT_TIMEOUT_SECONDS=3
DB_READINESS_TIMEOUT_SECONDS=3

FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-Request-ID
CORS_ALLOW_CREDENTIALS=False
ENABLE_HSTS=False
