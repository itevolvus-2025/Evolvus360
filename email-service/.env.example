APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/evolvus_email
EMAIL_SERVICE_API_KEY=replace-with-a-long-random-service-key
EMAIL_SERVICE_ADMIN_API_KEY=replace-with-a-different-long-random-admin-key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_PAYLOAD_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Evolvus360
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT_SECONDS=10
MAX_ATTACHMENT_SIZE_BYTES=5242880
MAX_TOTAL_ATTACHMENT_SIZE_BYTES=10485760
MAX_RETRIES=3
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
